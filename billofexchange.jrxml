		<band height="525">
			<staticText>
				<reportElement x="1" y="23" width="90" height="30" uuid="1bbcb789-7d17-40c1-b0d5-36ffb7af3c71"/>
				<textElement>
					<font size="14" isBold="true"/>
				</textElement>
				<text><![CDATA[Dear Sir(s),]]></text>
			</staticText>
			<staticText>
				<reportElement x="43" y="71" width="480" height="20" uuid="7bc331b7-f984-4b83-862c-a634342b81a7"/>
				<textElement>
					<font size="14" isBold="false"/>
				</textElement>
				<text><![CDATA[We send herewith the following documents together with our Bill of Supply for Rs.]]></text>
			</staticText>
			<staticText>
				<reportElement x="4" y="97" width="675" height="20" uuid="d134acb0-fafc-4b74-9e0b-38dbca7ed3bd"/>
				<textElement>
					<font size="14" isBold="false"/>
				</textElement>
				<text><![CDATA[for despatch of raw Jute to the above mill and receipt of which may kindly be acknowledged.]]></text>
			</staticText>
			<staticText>
				<reportElement x="49" y="121" width="301" height="20" uuid="be67bafb-fb94-4275-b7e1-8db2f3670b20"/>
				<textElement>
					<font size="14" isBold="false"/>
				</textElement>
				<text><![CDATA[You are requested to collect the bills and pay us the proceeds on maturity]]></text>
			</staticText>
			<staticText>
				<reportElement x="8" y="146" width="170" height="20" uuid="9e966984-95ef-4c6c-94ab-eb18f4ecf419"/>
				<textElement>
					<font size="14" isBold="false"/>
				</textElement>
				<text><![CDATA[1) Draft in duplicate for Rs]]></text>
			</staticText>
			<staticText>
				<reportElement x="8" y="174" width="154" height="20" uuid="12118758-6c83-41e5-8a49-716e9b5cd9ac"/>
				<textElement>
					<font size="14" isBold="false"/>
				</textElement>
				<text><![CDATA[2) Our Bill of Supply No.]]></text>
			</staticText>
			<staticText>
				<reportElement x="7" y="221" width="540" height="20" uuid="e0bd09be-b838-46c3-97b1-759a6b94a89e"/>
				<textElement>
					<font size="14" isBold="false"/>
				</textElement>
				<text><![CDATA[3) Challan/Consignment Note/Boat Note/Mill Receipt ]]></text>
			</staticText>
			<staticText>
				<reportElement x="5" y="249" width="204" height="20" uuid="9c74d80f-bc1f-444b-a32b-78b9312cd83c"/>
				<textElement>
					<font size="14" isBold="false"/>
				</textElement>
				<text><![CDATA[4) Our Bill of Supply falls due on   ]]></text>
			</staticText>
			<staticText>
				<reportElement x="6" y="278" width="234" height="20" uuid="4d2c985d-c7e7-45f1-b9fb-04399b00bb75"/>
				<textElement textAlignment="Left">
					<font size="14" isBold="false"/>
				</textElement>
				<text><![CDATA[5) Original Letter of Credit, being No.]]></text>
			</staticText>
			<staticText>
				<reportElement x="6" y="326" width="664" height="20" uuid="ee2dba30-6b19-4d84-adcc-1c28f2741ee4"/>
				<textElement>
					<font size="14" isBold="false"/>
				</textElement>
				<text><![CDATA[6) Certified that the transit risk of the goods consigned against the despatch documents and attached]]></text>
			</staticText>
			<staticText>
				<reportElement x="8" y="346" width="668" height="20" uuid="a883b394-11b3-4bbb-b721-08872c1a1be8"/>
				<textElement>
					<font size="14" isBold="false"/>
				</textElement>
				<text><![CDATA[with the draft have been covered by The Jute Corporation of India Limited, under its own arrangement]]></text>
			</staticText>
			<staticText>
				<reportElement x="9" y="370" width="650" height="20" uuid="0b4e3a75-84e0-4bfc-990b-2ba254247a6d"/>
				<textElement>
					<font size="14" isBold="false"/>
				</textElement>
				<text><![CDATA[in case of Mill Delivery.]]></text>
			</staticText>
			<staticText>
				<reportElement x="4" y="396" width="626" height="24" uuid="9fefb111-468e-487a-a9a3-213fc150c4ff"/>
				<textElement>
					<font size="14" isBold="false"/>
				</textElement>
				<text><![CDATA[7) The proceeds of the bill please be credited to Central Bank of India, Branch - New Market,]]></text>
			</staticText>
			<staticText>
				<reportElement x="5" y="434" width="339" height="20" uuid="acc6e9c1-d01f-4451-9a00-c19e9fbafcf9"/>
				<textElement>
					<font size="14" isBold="false"/>
				</textElement>
				<text><![CDATA[8) All bank charges to be borne by the applicant]]></text>
			</staticText>
			<staticText>
				<reportElement x="9" y="469" width="130" height="20" uuid="3f0b34ec-e53b-4e2e-a72d-16f70948bdf9"/>
				<textElement>
					<font size="14" isBold="false"/>
				</textElement>
				<text><![CDATA[Thanking you]]></text>
			</staticText>
			<staticText>
				<reportElement x="2" y="505" width="200" height="20" uuid="2f2dbc58-a0fd-4948-820f-65d93f42941e"/>
				<textElement>
					<font size="14" isBold="false"/>
				</textElement>
				<text><![CDATA[Enclosure : As above]]></text>
			</staticText>
			<staticText>
				<reportElement x="279" y="500" width="380" height="20" uuid="c6184090-76d6-435b-85c3-d645a18b8222"/>
				<textElement textAlignment="Right">
					<font size="14" isBold="false"/>
				</textElement>
				<text><![CDATA[(Assistant Finance Manager / Deputy Finance Manager)]]></text>
			</staticText>
			<staticText>
				<reportElement x="490" y="454" width="122" height="26" uuid="08bc786c-e9fa-45c0-8b2a-f4df096d28e3"/>
				<textElement>
					<font size="14" isBold="false"/>
				</textElement>
				<text><![CDATA[Yours faithfully,]]></text>
			</staticText>
